{
  "name": "ScopePilot WF08 - Authenticated MCP Read API",
  "nodes": [
    {
      "parameters": {"path":"scopeledger-mcp-project-context","authentication":"headerAuth","responseMode":"responseNode","options":{}},
      "id": "b8c9d0e1-0008-4000-8000-000000000001",
      "name": "Project Context Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0,-120],
      "webhookId": "91a87b1c-3e4f-4d6a-8b1e-0123456789c1",
      "credentials": {"httpHeaderAuth":{"id":"REPLACE_SCOPELEDGER_INTERNAL_HEADER","name":"scopeledger-internal-webhook"}}
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id AS project_id,p.name,p.currency,p.repo_owner,p.repo_name,p.drive_folder_id,sv.id AS scope_version_id,sv.version AS scope_version,sv.normalized_scope,sv.content_hash,sv.document_id,sv.provider_revision FROM scopeledger.projects p JOIN scopeledger.scope_versions sv ON sv.id=p.active_scope_id WHERE p.id=$1::uuid AND p.id=$2::uuid;",
        "options": {"queryReplacement":"={{ [$json.query.project_id,$env.SCOPELEDGER_PROJECT_ID] }}"}
      },
      "id": "b8c9d0e1-0008-4000-8000-000000000002",
      "name": "Read Configured Project",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [280,-120],
      "credentials": {"postgres":{"id":"REPLACE_SCOPELEDGER_READER_DB","name":"scopeledger-reader-db"}}
    },
    {
      "parameters": {"respondWith":"json","responseBody":"={{ JSON.stringify($json) }}","options":{"responseCode":200}},
      "id": "b8c9d0e1-0008-4000-8000-000000000003",
      "name": "Return Project Context",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [560,-120]
    },
    {
      "parameters": {"path":"scopeledger-mcp-case-evidence","authentication":"headerAuth","responseMode":"responseNode","options":{}},
      "id": "b8c9d0e1-0008-4000-8000-000000000004",
      "name": "Case Evidence Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0,140],
      "webhookId": "91a87b1c-3e4f-4d6a-8b1e-0123456789c2",
      "credentials": {"httpHeaderAuth":{"id":"REPLACE_SCOPELEDGER_INTERNAL_HEADER","name":"scopeledger-internal-webhook"}}
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id AS case_id,c.state,c.request_excerpt,c.evidence_version,e.provider,e.resource_id,e.provider_revision,e.content_hash,e.excerpt,e.safe_url,e.retrieved_at FROM scopeledger.cases c JOIN scopeledger.evidence e ON e.case_id=c.id AND e.evidence_version=c.evidence_version WHERE c.id=$1::uuid AND c.project_id=$2::uuid ORDER BY e.provider,e.resource_id;",
        "options": {"queryReplacement":"={{ [$json.query.case_id,$env.SCOPELEDGER_PROJECT_ID] }}"}
      },
      "id": "b8c9d0e1-0008-4000-8000-000000000005",
      "name": "Read Configured Case Evidence",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [280,140],
      "credentials": {"postgres":{"id":"REPLACE_SCOPELEDGER_READER_DB","name":"scopeledger-reader-db"}}
    },
    {
      "parameters": {"respondWith":"json","responseBody":"={{ JSON.stringify($input.all().map(i => i.json)) }}","options":{"responseCode":200}},
      "id": "b8c9d0e1-0008-4000-8000-000000000006",
      "name": "Return Case Evidence",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [560,140]
    }
  ],
  "pinData": {},
  "connections": {
    "Project Context Request":{"main":[[{"node":"Read Configured Project","type":"main","index":0}]]},
    "Read Configured Project":{"main":[[{"node":"Return Project Context","type":"main","index":0}]]},
    "Case Evidence Request":{"main":[[{"node":"Read Configured Case Evidence","type":"main","index":0}]]},
    "Read Configured Case Evidence":{"main":[[{"node":"Return Case Evidence","type":"main","index":0}]]}
  },
  "active": false,
  "settings": {"executionOrder":"v1","saveDataSuccessExecution":"none","saveDataErrorExecution":"none"}
}

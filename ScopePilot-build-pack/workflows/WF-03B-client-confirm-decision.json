{
  "name": "ScopePilot WF03B - Client Confirm Decision",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scopeledger-client-decision-confirm",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000101",
      "name": "Client Confirmation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "91a87b1c-3e4f-4d6a-8b1e-0123456789bd"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT decision_id, case_id, case_state, receipt_status\nFROM scopeledger.confirm_client_decision(\n  $1::uuid,\n  $2::text,\n  $3::text,\n  $4::text,\n  $5::text,\n  $6::text\n);",
        "options": {
          "queryReplacement": "={{ [\n  $json.body.challenge_id,\n  String($json.body.code || ''),\n  $json.body.decision,\n  $json.body.option_id || '',\n  $json.body.comment || '',\n  $json.body.correlation_id || ('client-confirm-' + $execution.id)\n] }}"
        }
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000102",
      "name": "Verify OTP And Decide",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [280, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_SCOPELEDGER_WEB_DB",
          "name": "scopeledger-web-db"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  status: $json.case_state,\n  decision_id: $json.decision_id,\n  case_id: $json.case_id,\n  receipt_status: $json.receipt_status\n}) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000103",
      "name": "Return Decision Receipt",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [560, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Client Confirmation": {
      "main": [[{ "node": "Verify OTP And Decide", "type": "main", "index": 0 }]]
    },
    "Verify OTP And Decide": {
      "main": [[{ "node": "Return Decision Receipt", "type": "main", "index": 0 }]]
    }
  },
  "active": false,

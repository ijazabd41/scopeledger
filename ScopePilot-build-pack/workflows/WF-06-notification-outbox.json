{
  "name": "ScopePilot WF06 - Scheduled Gmail Outbox",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "f6a7b8c9-0006-4000-8000-000000000001",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS notification_id, case_id, proposal_id, recipient, template_id, approved_content, mail_marker\nFROM scopeledger.claim_next_notification('n8n-outbox-worker', 120);",
        "options": {}
      },
      "id": "f6a7b8c9-0006-4000-8000-000000000002",
      "name": "Claim Next Notification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [260, 0],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_SCOPELEDGER_WORKER_DB",
          "name": "scopeledger-worker-db"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "notification-present",
              "leftValue": "={{ $json.notification_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f6a7b8c9-0006-4000-8000-000000000003",
      "name": "Has Notification",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.recipient }}",
        "subject": "={{ $json.template_id === 'reminder_client_review' ? 'Reminder: ScopePilot proposal awaiting your decision' : 'ScopePilot notification' }}",
        "emailType": "text",
        "message": "={{ 'ScopePilot notification\\n\\nReference: ' + $json.mail_marker + '\\nCase: ' + $json.case_id + '\\nProposal: ' + ($json.proposal_id || 'n/a') + '\\n\\n' + JSON.stringify($json.approved_content, null, 2) + '\\n\\nReview portal: ' + ($env.PUBLIC_REVIEW_URL || 'CONFIGURE_PUBLIC_REVIEW_URL') }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "f6a7b8c9-0006-4000-8000-000000000004",
      "name": "Send Approved Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [760, -80],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_SCOPELEDGER_GMAIL",
          "name": "scopeledger-gmail"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT scopeledger.record_notification_result(\n  $1::uuid,\n  'n8n-outbox-worker',\n  'sent',\n  $2::text,\n  NULL\n);",
        "options": {
          "queryReplacement": "={{ [\n  $('Claim Next Notification').first().json.notification_id,\n  $json.id || $json.messageId || $json.threadId\n] }}"
        }
      },
      "id": "f6a7b8c9-0006-4000-8000-000000000005",
      "name": "Record Provider Delivery",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1020, -80],
      "credentials": {
        "postgres": {
          "id": "REPLACE_SCOPELEDGER_WORKER_DB",
          "name": "scopeledger-worker-db"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Every Minute": {
      "main": [[{ "node": "Claim Next Notification", "type": "main", "index": 0 }]]
    },
    "Claim Next Notification": {
      "main": [[{ "node": "Has Notification", "type": "main", "index": 0 }]]
    },
    "Has Notification": {
      "main": [
        [{ "node": "Send Approved Notification", "type": "main", "index": 0 }],
        []
      ]
    },
    "Send Approved Notification": {
      "main": [[{ "node": "Record Provider Delivery", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  }
}

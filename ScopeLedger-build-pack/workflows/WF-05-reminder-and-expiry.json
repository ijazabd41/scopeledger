{
  "name": "ScopeLedger WF05 - Reminder and Expiry",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scopeledger-cron-expiry",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "e5f6a7b8-0005-4000-8000-000000000001",
      "name": "Cron Expiry Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "91a87b1c-3e4f-4d6a-8b1e-0123456789af"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT scopeledger.expire_due_proposals('cron-scheduled') AS expired_count;",
        "options": {}
      },
      "id": "e5f6a7b8-0005-4000-8000-000000000002",
      "name": "Expire Due Proposals",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 0],
      "credentials": {
        "postgres": {
          "id": "YLxzohMuXai17DAX",
          "name": "scopeledger-postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH due_proposals AS (\n  SELECT p.id as proposal_id\n  FROM scopeledger.proposals p\n  JOIN scopeledger.cases c ON c.id = p.case_id\n  WHERE p.status = 'published'\n    AND c.state = 'awaiting_client'\n    AND p.published_at <= now() - interval '24 hours'\n)\nSELECT count(scopeledger.enqueue_proposal_reminder(d.proposal_id)) as reminders_enqueued\nFROM due_proposals d;",
        "options": {}
      },
      "id": "e5f6a7b8-0005-4000-8000-000000000003",
      "name": "Enqueue 24h Reminders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 0],
      "credentials": {
        "postgres": {
          "id": "YLxzohMuXai17DAX",
          "name": "scopeledger-postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  status: 'success',\n  expired_proposals_count: $('Expire Due Proposals').first().json.expired_count,\n  reminders_enqueued: $json.reminders_enqueued\n}) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "e5f6a7b8-0005-4000-8000-000000000004",
      "name": "Return Expiry Receipt",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [720, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Cron Expiry Webhook": {
      "main": [[{ "node": "Expire Due Proposals", "type": "main", "index": 0 }]]
    },
    "Expire Due Proposals": {
      "main": [[{ "node": "Enqueue 24h Reminders", "type": "main", "index": 0 }]]
    },
    "Enqueue 24h Reminders": {
      "main": [[{ "node": "Return Expiry Receipt", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}

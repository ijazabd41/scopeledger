# Checklist only. Replace placeholders in the platform secret/configuration UI.
# Pin the actual supported version/digest; this is not a runnable deployment file.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:<PINNED_VERSION>
N8N_HOST=<ACTUAL_PUBLIC_HOSTNAME>
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://<ACTUAL_PUBLIC_HOSTNAME>/
N8N_EDITOR_BASE_URL=https://<ACTUAL_EDITOR_HOSTNAME>/
# Set to actual trusted proxy count; verify against pinned n8n and ingress.
N8N_PROXY_HOPS=<VERIFIED_PROXY_COUNT>
N8N_ENCRYPTION_KEY=<STRONG_STABLE_SECRET>
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=<N8N_OPERATIONAL_DB_HOST>
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=<N8N_OPERATIONAL_DATABASE>
DB_POSTGRESDB_USER=<N8N_OPERATIONAL_ROLE>
DB_POSTGRESDB_PASSWORD=<SECRET>
GENERIC_TIMEZONE=Asia/Karachi
TZ=UTC
# Configure database TLS/CA and execution retention using verified release settings.
# Persist n8n data and any binary storage according to deployment.md.
# Business PostgreSQL, Gmail, Drive/Docs, GitHub, model and MCP secrets belong
# in separate n8n credentials. Do not paste them here or export their values.
# Application defaults below are specification values, not built-in n8n variables:
# OTP expiry 10m; max attempts 5; review token 15m; proposal expiry 72h.
